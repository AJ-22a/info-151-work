<section id="packages">

    <h1 class="section-title">Popular packages</h1>
    <img src="img/global/green-icon.svg" alt="green icon">

    <div id="package-button-container">
        <button id="left-arrow"><i class="fa-solid fa-chevron-left"></i></button>
        <button id="right-arrow"><i class="fa-solid fa-chevron-right"></i></button>
    </div>

    <ul id="package-card-container">
        <li class="package-card">
            <img src="img/packages/card-1.jpg" alt="people at a coffee shop" class="img-scaler">
            <p>The basic package to start your promotion</p>
            <ul>
                <li><img src="img/packages/user-1.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-3.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-2.jpg" alt="user icon"></li>
            </ul>
            <h4>200K+ users</h4>
            <h3>$89.00</h3>
        </li>

        <li class="selected package-card">
            <img src="img/packages/card-3.jpg" alt="people at a coffee shop" class="img-scaler">
            <p>The standard package to grow your business</p>
            <ul>
                <li><img src="img/packages/user-5.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-3.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-4.jpg" alt="user icon"></li>
            </ul>
            <h4>140K+ users</h4>
            <h3>$109.00</h3>
        </li>

        <li class="package-card">
            <img src="img/packages/card-2.jpg" alt="people at a coffee shop" class="img-scaler">
            <p>The premium package to boost your promotion</p>
            <ul>
                <li><img src="img/packages/user-5.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-3.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-4.jpg" alt="user icon"></li>
            </ul>
            <h4>99K+ users</h4>
            <h3>$149.00</h3>
        </li>

    </ul>

</section>