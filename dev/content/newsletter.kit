<section id="newsletter" class="content-padding">
    <div id="newsletter-content">
        <section>
            <h1 class="section-title">Subscribe newsletter</h1>
            <img src="img/global/green-icon.svg" alt="green icon">
            <p class="body-grey-text">Businesses generally promote their brand, products, and services by identifying audience. No wonder that promotion strategy is one of the most important processes in marketing.</p>
    
            <form action="#">
                <input type="text" placeholder="Enter email address">
                <button class="nightBlue-btn">Subscribe</button>
            </form>
        </section>
    
        <aside>
            <img src="img/newsletter/hero.png" alt="happy man with thumbs up" class="img-scaler">
        </aside>
    </div>
</section>